{
  "name": "@reqraft/cli",
  "version": "0.1.5",
  "description": "CLI open source de reprompting — transforme une demande brute en un prompt clair, fidèle et directement exploitable par une IA.",
  "main": "./dist/cli.js",
  "type": "module",
  "bin": {
    "rp": "dist/cli.js",
    "reprompt": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsup",
    "lint": "eslint src tests benchmark scripts --ext .ts,.tsx",
    "lint:fix": "eslint src tests benchmark scripts --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"benchmark/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"benchmark/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "benchmark": "tsx benchmark/runner.ts",
    "benchmark:fidelity": "tsx benchmark/fidelity-runner.ts",
    "typecheck": "tsc --noEmit",
    "quality": "pnpm typecheck && pnpm format:check && pnpm lint && pnpm build && pnpm test:coverage",
    "pack:dry-run": "pnpm publish --dry-run --access public --ignore-scripts",
    "release:check": "pnpm quality && pnpm pack:dry-run",
    "release": "tsx scripts/release.ts",
    "publish:public": "pnpm publish --access public",
    "prepublishOnly": "pnpm quality",
    "prepack": "pnpm build"
  },
  "keywords": [
    "cli",
    "prompt",
    "reprompting",
    "ai",
    "llm",
    "anthropic",
    "openai",
    "developer-tools"
  ],
  "author": "Reqraft Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronael/Reqraft.git"
  },
  "bugs": {
    "url": "https://github.com/ronael/Reqraft/issues"
  },
  "homepage": "https://ronael.github.io/Reqraft/",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.16": "1.1.18",
      "brace-expansion@2.1.3": "2.1.4",
      "brace-expansion@5.0.8": "5.0.9",
      "esbuild@0.27.7": "0.28.2",
      "js-yaml@4.3.0": "4.3.1"
    }
  },
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/react": "0.4.5",
    "clipboardy": "^4.0.0",
    "commander": "^12.1.0",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.0",
    "react-devtools-core": "^7.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^22.7.4",
    "@types/react": "^19.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.11.1",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  }
}
